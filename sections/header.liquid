<header>
  <h2 class="header__title">
    {{ shop.name | link_to: routes.root_url }}
  </h2>

  <nav class="header__menu">
    {% for link in section.settings.menu.links %}
      {% liquid
        assign media_block = blank
        for block in section.blocks
          if block.settings.menu_title == link.title
            assign media_block = block
          endif
        endfor
      %}

      <div class="header__nav-item">
        <a
          href="{{ link.url }}"
          class="header__nav-link"
          {% if link.links.size > 0 %}
            aria-haspopup="true"
          {% endif %}
        >
          {{ link.title }}
        </a>

        {% if link.links.size > 0 %}
          {% render 'header-mega-menu', link: link, media_block: media_block %}
        {% endif %}
      </div>
    {% endfor %}
  </nav>

  <div class="header__icons">
    {% if shop.customer_accounts_enabled %}
      <shopify-account menu="{{ section.settings.customer_account_menu }}">
        {{ 'icon-account.svg' | inline_asset_content }}
      </shopify-account>
    {% endif %}

    <a href="{{ routes.cart_url }}">
      {% if cart.item_count > 0 %}
        <sup>{{ cart.item_count }}</sup>
      {% endif %}

      {{ 'icon-cart.svg' | inline_asset_content }}
    </a>
  </div>
</header>

{% stylesheet %}
  header {
    position: relative;
    height: 5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  header a {
    position: relative;
    text-decoration: none;
    color: var(--color-foreground);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  header a sup {
    position: absolute;
    left: 100%;
    overflow: hidden;
    max-width: var(--page-margin);
  }
  header svg {
    width: 2rem;
  }
  header .header__menu,
  header .header__icons {
    display: flex;
    gap: 1rem;
  }

  .header__nav-item {
    position: static;
    display: flex;
    align-items: center;
  }

  .header__nav-link {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ],
  "blocks": [
    {
      "type": "mega_menu",
      "name": "t:general.mega_menu",
      "settings": [
        {
          "type": "text",
          "id": "menu_title",
          "label": "t:labels.menu_item_title",
          "info": "t:labels.menu_item_title_info"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.featured_image"
        },
        {
          "type": "url",
          "id": "image_url",
          "label": "t:labels.featured_link"
        },
        {
          "type": "text",
          "id": "image_heading",
          "label": "t:labels.featured_heading"
        }
      ]
    }
  ]
}
{% endschema %}
