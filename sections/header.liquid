<header class="header" data-transparent="{{ section.settings.transparent }}" data-text-color="{{ section.settings.text_color }}">
  <div class="header__row-top">
    <div class="header__start">
      <button
        type="button"
        class="header__menu-toggle"
        data-mobile-menu-open
        aria-haspopup="dialog"
        aria-controls="MobileMenu-{{ section.id }}"
        aria-label="{{ 'general.accessibility.menu' | t }}"
      >
        <span class="header__menu-toggle-bar"></span>
        <span class="header__menu-toggle-bar"></span>
        <span class="header__menu-toggle-bar"></span>
      </button>
    </div>

    <h2 class="header__title">
      <a href="{{ routes.root_url }}" class="header__brand">{{ 'general.brand_name' | t }}</a>
    </h2>

    <div class="header__icons">
      <button
        type="button"
        class="header__search-toggle"
        data-search-drawer-open
        aria-haspopup="dialog"
        aria-controls="SearchDrawer-{{ section.id }}"
        aria-label="{{ 'search.title' | t }}"
      >
        {{ 'icon-search.svg' | inline_asset_content }}
      </button>

      {% if shop.customer_accounts_enabled %}
        <shopify-account menu="{{ section.settings.customer_account_menu }}">
          {{ 'icon-account.svg' | inline_asset_content }}
        </shopify-account>
      {% endif %}

      <a href="{{ routes.cart_url }}">
        {% if cart.item_count > 0 %}
          <sup>{{ cart.item_count }}</sup>
        {% endif %}

        {{ 'icon-cart.svg' | inline_asset_content }}
      </a>
    </div>
  </div>

  <nav class="header__menu">
    {% for link in section.settings.menu.links %}
      {% liquid
        assign media_block = blank
        for block in section.blocks
          if block.settings.menu_title == link.title
            assign media_block = block
          endif
        endfor
      %}

      <div class="header__nav-item">
        <a
          href="{{ link.url }}"
          class="header__nav-link"
          {% if link.links.size > 0 %}
            aria-haspopup="true"
          {% endif %}
        >
          {{ link.title }}
        </a>

        {% if link.links.size > 0 %}
          {% render 'header-mega-menu', link: link, media_block: media_block %}
        {% endif %}
      </div>
    {% endfor %}
  </nav>
</header>

{% render 'search-drawer', id: 'SearchDrawer-' | append: section.id %}
{% render 'mobile-menu', id: 'MobileMenu-' | append: section.id, menu: section.settings.menu %}

{% stylesheet %}
  .header {
    --header-color: var(--color-black);
    position: relative;
    display: flex;
    flex-direction: column;
    color: var(--header-color);
    background-color: var(--color-background);
    transition: color 0.3s ease, background-color 0.3s ease;
  }

  .header[data-text-color='light'] {
    --header-color: var(--color-white);
  }

  .header[data-transparent='true'] {
    position: absolute;
    inset: 0 0 auto 0;
    width: 100%;
    z-index: 20;
    background-color: transparent;
  }

  .header a {
    position: relative;
    text-decoration: none;
    color: inherit;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .header a sup {
    position: absolute;
    left: 100%;
    overflow: hidden;
    max-width: var(--page-margin);
  }

  .header svg {
    width: 2rem;
    color: inherit;
  }

  .header__row-top {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    column-gap: 1rem;
    height: 5rem;
  }

  .header__start {
    display: flex;
    align-items: center;
    justify-self: start;
    min-width: 0;
  }

  .header__menu {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2.5rem;
    padding-top: 1rem;
  }

  .header__menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 20px;
    border: none;
    background: transparent;
    padding: 0;
    color: inherit;
    cursor: pointer;
  }

  .header__menu-toggle-bar {
    display: block;
    width: 100%;
    height: 1px;
    background-color: currentColor;
  }

  .header__title {
    grid-column: 2;
    margin: 0;
    justify-self: center;
  }

  .header__brand {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    text-align: center;
    margin: 0;
  }

  .header__icons {
    display: flex;
    align-items: center;
    gap: 1rem;
    justify-self: end;
  }

  .header__search-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    background: transparent;
    padding: 0;
    color: inherit;
    cursor: pointer;
  }

  .header__search-toggle svg {
    width: 20px;
    height: 20px;
    --icon-stroke-width: 1.5;
  }

  .header__nav-item {
    position: static;
    display: flex;
    align-items: center;
  }

  .header__nav-link {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: none;
  }

  @media (max-width: 767px) {
    .header__menu {
      display: none;
    }

    .header__menu-toggle {
      display: flex;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    },
    {
      "type": "checkbox",
      "id": "transparent",
      "label": "t:labels.transparent_header",
      "info": "t:labels.transparent_header_info",
      "default": false
    },
    {
      "type": "select",
      "id": "text_color",
      "label": "t:labels.header_text_color",
      "options": [
        { "value": "dark", "label": "t:options.text_color.dark" },
        { "value": "light", "label": "t:options.text_color.light" }
      ],
      "default": "dark"
    }
  ],
  "blocks": [
    {
      "type": "mega_menu",
      "name": "t:general.mega_menu",
      "settings": [
        {
          "type": "text",
          "id": "menu_title",
          "label": "t:labels.menu_item_title",
          "info": "t:labels.menu_item_title_info"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.featured_image"
        },
        {
          "type": "url",
          "id": "image_url",
          "label": "t:labels.featured_link"
        },
        {
          "type": "text",
          "id": "image_heading",
          "label": "t:labels.featured_heading"
        }
      ]
    }
  ]
}
{% endschema %}
