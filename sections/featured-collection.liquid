{% comment %}
  Borderless 3-column product grid: strict 2:3 image wrappers, 12px
  micro-type titles, plain price. No badges, no borders.
{% endcomment %}

<div class="featured-collection full-width">
  {% if section.settings.title != blank %}
    <h2 class="featured-collection__title">{{ section.settings.title }}</h2>
  {% endif %}

  {% if section.settings.collection.products.size > 0 %}
    <div class="featured-collection__grid">
      {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
        <div class="featured-collection__item">
          {% render 'image',
            class: 'featured-collection__image',
            image: product.featured_image,
            url: product.url,
            width: 800,
            height: 1200,
            crop: 'center'
          %}

          <div class="featured-collection__info">
            <a href="{{ product.url }}" class="featured-collection__product-title">
              {{ product.title | escape }}
            </a>
            <span class="featured-collection__price">{{ product.price | money }}</span>
          </div>
        </div>
      {% endfor %}
    </div>
  {% elsif request.design_mode %}
    <p class="featured-collection__empty">{{ 'sections.featured_collection.select_collection' | t }}</p>
  {% endif %}
</div>

{% stylesheet %}
  .featured-collection {
    padding: 4rem 0;
  }

  .featured-collection__title {
    font-size: var(--font-size-base);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    margin-bottom: 2rem;
  }

  .featured-collection__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: 1.5rem;
    row-gap: 3rem;
  }

  @media (max-width: 989px) {
    .featured-collection__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 599px) {
    .featured-collection__grid {
      grid-template-columns: 1fr;
    }
  }

  .featured-collection__item {
    display: flex;
    flex-direction: column;
  }

  .featured-collection__image {
    aspect-ratio: var(--aspect-ratio-media);
  }

  .featured-collection__info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
    margin-top: 1rem;
  }

  .featured-collection__product-title {
    font-size: var(--font-size-base);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-foreground);
    border: none;
  }

  .featured-collection__price {
    font-size: var(--font-size-base);
    color: var(--color-foreground);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.featured_collection",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:labels.title",
      "default": "Featured collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:labels.collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:labels.products_to_show",
      "min": 3,
      "max": 12,
      "step": 3,
      "default": 6
    }
  ],
  "presets": [
    {
      "name": "t:general.featured_collection"
    }
  ]
}
{% endschema %}
