{% doc %}
  Renders a full-screen mobile navigation drawer, opened via a trigger button
  that references this drawer's `id` through `aria-controls`.

  Top-level links with nested sub-links render as expandable groups; links
  without sub-links render as plain links.

  @param {string} id - Unique id for the dialog element.
  @param {object} menu - A linklist object whose `links` are rendered as the drawer's navigation.

  @example
  {% render 'mobile-menu', id: 'MobileMenu', menu: section.settings.menu %}
{% enddoc %}

<dialog id="{{ id }}" class="mobile-menu" scroll-lock>
  <div class="mobile-menu__panel">
    <button
      type="button"
      class="mobile-menu__close"
      data-mobile-menu-close
      aria-label="{{ 'general.accessibility.close_menu' | t }}"
    >
      {{ 'general.accessibility.close_menu' | t }}
    </button>

    <nav class="mobile-menu__nav">
      {% for link in menu.links %}
        {% if link.links.size > 0 %}
          <details class="mobile-menu__group">
            <summary class="mobile-menu__link mobile-menu__summary">{{ link.title }}</summary>
            <div class="mobile-menu__sublinks">
              {% for sub_link in link.links %}
                <a href="{{ sub_link.url }}" class="mobile-menu__sublink">{{ sub_link.title }}</a>
              {% endfor %}
            </div>
          </details>
        {% else %}
          <a href="{{ link.url }}" class="mobile-menu__link">{{ link.title }}</a>
        {% endif %}
      {% endfor %}
    </nav>
  </div>
</dialog>

{% stylesheet %}
  .mobile-menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    border: none;
    padding: 0;
    background-color: var(--color-white);
    color: var(--color-black);
  }

  .mobile-menu::backdrop {
    background-color: rgba(0, 0, 0, 0.3);
  }

  .mobile-menu__panel {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    width: 100%;
    height: 100%;
    max-width: 100%;
    overflow-y: auto;
    padding: 2rem var(--page-margin);
  }

  .mobile-menu__close {
    align-self: flex-end;
    border: none;
    background: transparent;
    padding: 0;
    font-size: 12px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-black);
    cursor: pointer;
  }

  .mobile-menu__nav {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .mobile-menu__link {
    display: block;
    width: 100%;
    font-size: 14px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-black);
    border: none;
  }

  .mobile-menu__summary {
    cursor: pointer;
    list-style: none;
  }

  .mobile-menu__summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu__sublinks {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1rem 0 0 1rem;
  }

  .mobile-menu__sublink {
    font-size: 12px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-slate-600);
    border: none;
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('click', (event) => {
    const opener = event.target.closest('[data-mobile-menu-open]');
    if (opener) {
      const drawer = document.getElementById(opener.getAttribute('aria-controls'));
      if (drawer) drawer.showModal();
    }

    const closer = event.target.closest('[data-mobile-menu-close]');
    if (closer) {
      closer.closest('dialog')?.close();
    }

    const drawer = event.target.closest('dialog.mobile-menu');
    if (drawer && event.target === drawer) {
      drawer.close();
    }
  });
{% endjavascript %}
